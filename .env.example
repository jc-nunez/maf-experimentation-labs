# Copy to .env (gitignored). Values here are read by every host (Python and .NET).

# Which provider to use: sglang | openai | azure-openai | foundry | mock
MAF_PROVIDER=sglang

# --- SGLang (OpenAI-compatible, Responses API) -----------------------------
SGLANG_BASE_URL=http://<your-sglang-host>:30000/v1
SGLANG_MODEL=RadixArk/Qwen3.8-Flash-Next-NVFP4
SGLANG_API_KEY=EMPTY
# responses (default) or chat (Chat Completions fallback)
SGLANG_API=responses
# Keep history client-side (store=false). Set to true only if your server supports stored responses.
SGLANG_STORE=false

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Azure OpenAI -----------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Leave empty to use Entra ID (az login / DefaultAzureCredential)
AZURE_OPENAI_API_KEY=

# --- Microsoft Foundry ------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# --- Telemetry (optional) ---------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
