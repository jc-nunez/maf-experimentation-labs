# Copy to .env (gitignored). Values here are read by every host (Python and .NET).

# Which provider to use: sglang | openai | azure-openai | foundry | mock
MAF_PROVIDER=sglang

# --- SGLang (OpenAI-compatible, Responses API) -----------------------------
SGLANG_BASE_URL=http://<your-sglang-host>:30000/v1
SGLANG_MODEL=RadixArk/Qwen3.8-Flash-Next-NVFP4
SGLANG_API_KEY=EMPTY
# responses (default) or chat (Chat Completions fallback)
SGLANG_API=responses
# Keep history client-side (store=false). Set to true only if your server supports stored responses.
SGLANG_STORE=false

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Azure OpenAI -----------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Leave empty to use Entra ID (az login / DefaultAzureCredential)
AZURE_OPENAI_API_KEY=

# --- Microsoft Foundry ------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# --- Web tools (tools/python/web-search) -------------------------------------
# SearXNG instance with the JSON format enabled: `mafx infra up searxng` then http://127.0.0.1:8888.
# Without it, web_search falls back to DuckDuckGo (no service, but rate-limited at times).
SEARXNG_URL=
# auto (SearXNG if SEARXNG_URL is set, else DuckDuckGo) | searxng | ddgs
WEB_SEARCH_BACKEND=auto
# fetch_url refuses private / loopback / tailnet addresses unless this is true
WEB_FETCH_ALLOW_PRIVATE=false

# --- Mail (projects/mail) ----------------------------------------------------
# Application (client) id of the `mafx-mail` app registration (personal accounts, public client, Mail.Read).
# Then sign in once: uv run python -m mail_agent.auth outlook --alias personal
MAIL_OUTLOOK_CLIENT_ID=

# --- Telemetry (optional) ---------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
